# Com ngrok, deixe VITE_SOCKET_URL por definir: a sinalização usa a origem da página.
# Nunca configure http://localhost:5000 para utilizadores remotos:
# localhost seria o dispositivo de cada utilizador, não o seu servidor.
# VITE_SOCKET_URL=https://signaling.exemplo.com

# Porta interna da sinalização; dev:all e o proxy partilham esta configuração.
# PORT=5000

# Servidor externo opcional (HTTP/HTTPS). Quando definido, dev:all não cria outro.
# SIGNALING_URL=http://127.0.0.1:5000

# Hosts de túnel autorizados (OBRIGATÓRIO ao usar ngrok), sem https://, separados por vírgula.
# Use o domínio que o ngrok lhe atribuir, por exemplo: o-seu-host.ngrok-free.app
# TUNNEL_HOSTS=o-seu-host.ngrok-free.app

# --- Conta por email (opcional, sem custos) ---
# O servidor envia o código de 6 dígitos por Gmail (SMTP). Crie uma "palavra-passe de aplicação":
# Conta Google > Segurança > Verificação em 2 passos (ativar) > Palavras-passe de aplicações.
# Sem estas variáveis o código aparece no terminal onde o servidor corre (útil para testes).
# GMAIL_USER=o.seu@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Onde o servidor guarda as contas (cópias já cifradas). Omissão: server/data/accounts.json
# ACCOUNTS_FILE=./server/data/accounts.json
